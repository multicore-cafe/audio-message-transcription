# Required
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
OPENAI_API_KEY=

# Optional
# OPENAI_ORGANIZATION=
# OpenAI-compatible endpoint. Local Speaches on this host (container `whisper-speaches`, port 8000,
# reachable because docker-compose.override.yml joins the bot to the whisper_default network):
# OPENAI_BASE_URL=http://whisper-speaches:8000/v1
# TRANSCRIPTION_MODEL=Systran/faster-whisper-large-v3-turbo
# Session file name or absolute path; relative names live in DATA_DIR (/data in Docker).
# TELEGRAM_SESSION=transcription_bot
# LOG_LEVEL=INFO

# Read-only Telegram MCP server: OFF by default. Only the exact value 1 enables it; 0 (or no value)
# disables it. The mcp service is scaled to 0 and `telegram-mcp serve|login` exit 2 when disabled.
# TELEGRAM_MCP_ENABLED=1
# Host path of the bearer-token file mounted as a Docker secret (default: ~/.config/telegram-mcp/token).
# TELEGRAM_MCP_TOKEN_FILE=/home/me/.config/telegram-mcp/token
# Token fallback for local runs without Docker (Compose always uses the secret file):
# MCP_AUTH_TOKEN=
# Its own session file, never the bot's (in its own Docker volume).
# TELEGRAM_MCP_SESSION=telegram_mcp
# Host port; the server is published on 127.0.0.1 only.
# MCP_PORT=8790
# Absolute host path of the export directory (default: ~/.local/share/telegram-mcp/exports, mode 0700).
# MCP_EXPORT_HOST_DIR=/home/me/.local/share/telegram-mcp/exports
# MCP_EXPORT_MAX_MESSAGES=50000
# Per media file, and for all media of one export_chat call.
# MCP_MEDIA_MAX_MB=50
# MCP_EXPORT_MAX_TOTAL_MB=1000
# Approximate size limit of one tool response, in characters (fits the local model's 65k context).
# MCP_MAX_RESPONSE_CHARS=16000
# MCP_DIALOG_CACHE_SECONDS=60
# Longer Telegram flood waits are returned to the client as an error instead of waiting.
# MCP_FLOOD_SLEEP_THRESHOLD=30
# Extra accepted Host / Origin headers (comma-separated), e.g. for a reverse proxy.
# MCP_ALLOWED_HOSTS=
# MCP_ALLOWED_ORIGINS=
