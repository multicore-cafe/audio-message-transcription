# Required
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
OPENAI_API_KEY=

# Optional
# OPENAI_ORGANIZATION=
# OPENAI_BASE_URL=https://api.openai.com/v1
# TRANSCRIPTION_MODEL=whisper-1
# Session file name or absolute path; relative names live in DATA_DIR (/data in Docker).
# TELEGRAM_SESSION=transcription_bot
# LOG_LEVEL=INFO

# Read-only Telegram MCP server (compose profile `mcp`); all optional.
# Bearer token the MCP clients must send. Without it any local process can read the account.
# Generate one with `openssl rand -hex 32`.
# MCP_AUTH_TOKEN=
# Its own session file, never the bot's (in its own Docker volume).
# TELEGRAM_MCP_SESSION=telegram_mcp
# Host port; the server is published on 127.0.0.1 only.
# MCP_PORT=8790
# Absolute host path of the export directory (default: ./exports, relative to where you run docker compose).
# MCP_EXPORT_HOST_DIR=/home/me/telegram-exports
# MCP_EXPORT_MAX_MESSAGES=50000
# Per media file, and for all media of one export_chat call.
# MCP_MEDIA_MAX_MB=50
# MCP_EXPORT_MAX_TOTAL_MB=1000
# Approximate size limit of one tool response, in characters.
# MCP_MAX_RESPONSE_CHARS=60000
# MCP_DIALOG_CACHE_SECONDS=60
# Longer Telegram flood waits are returned to the client as an error instead of waiting.
# MCP_FLOOD_SLEEP_THRESHOLD=30
# Extra accepted Host / Origin headers (comma-separated), e.g. for a reverse proxy.
# MCP_ALLOWED_HOSTS=
# MCP_ALLOWED_ORIGINS=
